# Own draft: partitions TWRP should know about (backup / flash image).
/boot         emmc  /dev/block/bootdevice/by-name/boot         flags=display="Boot";backup=1;flashimg=1;slotselect
/init_boot    emmc  /dev/block/bootdevice/by-name/init_boot    flags=display="Init Boot";backup=1;flashimg=1;slotselect
/vendor_boot  emmc  /dev/block/bootdevice/by-name/vendor_boot  flags=display="Vendor Boot";backup=1;flashimg=1;slotselect
/recovery     emmc  /dev/block/bootdevice/by-name/recovery     flags=display="Recovery";backup=1;flashimg=1;slotselect
/dtbo         emmc  /dev/block/bootdevice/by-name/dtbo         flags=display="DTBO";backup=1;flashimg=1;slotselect
/metadata     f2fs  /dev/block/by-name/metadata                flags=display="Metadata";backup=1
/persist      ext4  /dev/block/bootdevice/by-name/persist      flags=display="Persist"
/persist_image emmc /dev/block/bootdevice/by-name/persist      flags=display="Persist";backup=1
/firmware     vfat  /dev/block/bootdevice/by-name/modem        flags=slotselect;display="Firmware";mounttodecrypt;fsflags="ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0"
/storage      auto  /data/media/0                              flags=display="Internal Storage";backup=1;usermrf;fsflags="bind,utf8";removable
